<?xml version="1.0" encoding="utf-8"?>
<!-- AOD surface. Everything except the neon edge lives inside contentGroup,
     which is translated as ONE unit for burn-in protection. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aodRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aod_black"
    android:keepScreenOn="true">

    <com.customaod.ui.view.NeonEdgeView
        android:id="@+id/neonEdge"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/contentGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDate"
            style="@style/TextAppearance.CustomAOD.Aod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <!-- Clock: hour / colon / minute are separate views so each digit group can animate. -->
        <LinearLayout
            android:id="@+id/clockContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:textColor="@color/neon_cyan"
                android:textSize="88sp" />

            <TextView
                android:id="@+id/tvColon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:text=":"
                android:textColor="@color/neon_cyan"
                android:textSize="88sp" />

            <TextView
                android:id="@+id/tvMinute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:textColor="@color/neon_cyan"
                android:textSize="88sp" />
        </LinearLayout>

        <!-- Battery indicator directly below the clock. -->
        <LinearLayout
            android:id="@+id/batteryBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBolt"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/charging"
                    android:src="@drawable/ic_bolt"
                    android:visibility="gone"
                    app:tint="@color/neon_lime"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <TextView
                    android:id="@+id/tvBattery"
                    style="@style/TextAppearance.CustomAOD.Aod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_battery_track">

                <View
                    android:id="@+id/batteryFill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/aod_white" />
            </FrameLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="18dp"
            android:alpha="0.85"
            android:contentDescription="@string/custom_text"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCustomText"
            style="@style/TextAppearance.CustomAOD.Aod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:maxWidth="280dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifIcons"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNotifCount"
            style="@style/TextAppearance.CustomAOD.Aod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvWeather"
            style="@style/TextAppearance.CustomAOD.Aod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/musicRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_music"
                app:tint="@color/aod_dim_text"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <TextView
                android:id="@+id/tvMusic"
                style="@style/TextAppearance.CustomAOD.Aod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="240dp"
                android:singleLine="true"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aod_black"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/aod_black"
        app:title="@string/settings_title"
        app:titleTextColor="@color/aod_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ───────── Clock ───────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CustomAOD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.CustomAOD.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_clock" />

                    <TextView
                        style="@style/TextAppearance.CustomAOD.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clock_style" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvStyles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal" />

                    <TextView
                        style="@style/TextAppearance.CustomAOD.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/clock_size" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="48"
                        android:valueTo="120"
                        android:stepSize="2" />

                    <TextView
                        style="@style/TextAppearance.CustomAOD.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clock_color" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvColors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ───────── Content ───────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CustomAOD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.CustomAOD.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivImagePreview"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@color/surface_dark"
                            android:contentDescription="@string/btn_pick_image"
                            android:scaleType="fitCenter" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickImage"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/btn_pick_image" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearImage"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_clear_image" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/custom_text"
                        app:helperText="@string/custom_text_hint"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCustomText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:maxLength="60"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBattery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/show_battery" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/show_notifications" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMusic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/show_music" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchWeather"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/show_weather" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/weather_city"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ───────── Effects & behavior ───────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CustomAOD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.CustomAOD.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_effects" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNeon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/neon_charging" />

                    <TextView
                        style="@style/TextAppearance.CustomAOD.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/section_behavior" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTapWake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tap_to_wake" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFingerprint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fingerprint_unlock" />

                    <TextView
                        style="@style/TextAppearance.CustomAOD.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/brightness" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1"
                        android:valueTo="20"
                        android:stepSize="1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ───────── Schedule ───────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CustomAOD.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextAppearance.CustomAOD.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_schedule" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSchedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_enable" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartTime"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEndTime"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Rounded dark card used across Main and Settings. -->
    <style name="Widget.CustomAOD.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_dark</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <style name="TextAppearance.CustomAOD.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TextAppearance.CustomAOD.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/aod_dim_text</item>
    </style>

    <!-- Secondary AOD line (date, battery, notifications...). Deliberately dim. -->
    <style name="TextAppearance.CustomAOD.Aod" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/aod_dim_text</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
